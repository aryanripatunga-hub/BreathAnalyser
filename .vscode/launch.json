{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch FastAPI Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "console": "integratedTerminal"
        }
    ]
}
